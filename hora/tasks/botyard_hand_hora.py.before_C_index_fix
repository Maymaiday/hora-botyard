    def _write_constraint_metrics(self, delta, tilt, shape, position, tilt_penalty, velocity, rotation, failure):
        import json
        from pathlib import Path
        c=self.config['env']['constraints'];r=self.config['env']['reward']
        groups={}
        for scale in self.randomize_scale_list:
            mask=self.env_scales==float(scale)
            if not torch.any(mask):continue
            groups[str(float(scale))]=dict(positionErrorMm=float(torch.linalg.norm(delta[mask],dim=1).mean()*1000),
                maxPositionErrorMm=float(torch.linalg.norm(delta[mask],dim=1).max()*1000),tiltDeg=float(torch.rad2deg(tilt[mask]).mean()),
                weightedShape=float(shape[mask].mean()*float(r['poseDiffPenaltyScale'])),
                weightedPosition=0. if self.hora_baseline else float(position[mask].mean()*float(c['positionPenaltyScale'])),
                weightedTilt=0. if self.hora_baseline else float(tilt_penalty[mask].mean()*float(c['tiltPenaltyScale'])),
                weightedLinearVelocity=float(velocity[mask].mean()*float(r['objLinvelPenaltyScale'])),
                rotationReward=float(rotation[mask].mean()*float(r['rotateRewardScale'])),failedEnvs=int(failure[mask].sum()))
        entry=dict(controlStep=self.metric_counter,scales=groups)
        # Include one representative state so visual oddities can be inspected.
        entry['env0']=dict(q20=self.allegro_hand_dof_pos[0].cpu().numpy().tolist(),
            target16=self.cur_policy_targets[0].cpu().numpy().tolist(),referenceQ20=self.init_pose_buf[0].cpu().numpy().tolist(),
            referenceTarget16=self.holding_reference[0].cpu().numpy().tolist(),
            referencePosition=self.object_position_reference[0].cpu().numpy().tolist(),object7=self.object_pose[0].cpu().numpy().tolist())
        print('[METRICS]',json.dumps(dict(controlStep=entry['controlStep'],scales=groups)),flush=True)
        path=self.config['env'].get('metricsPath','')
        if path:
            destination=Path(path);destination.parent.mkdir(parents=True,exist_ok=True)
            with destination.open('a') as f:f.write(json.dumps(entry)+'\n')



def compute_hand_reward(
    object_linvel_penalty, object_linvel_penalty_scale: float,
    rotate_reward, rotate_reward_scale: float,
    pose_diff_penalty, pose_diff_penalty_scale: float,
    torque_penalty, torque_pscale: float,
    work_penalty, work_pscale: float,
):
    reward = rotate_reward_scale * rotate_reward
    # Distance from the hand to the object
    reward = reward + object_linvel_penalty * object_linvel_penalty_scale
    reward = reward + pose_diff_penalty * pose_diff_penalty_scale
    reward = reward + torque_penalty * torque_pscale
    reward = reward + work_penalty * work_pscale
    return reward


def quat_to_axis_angle(quaternions: torch.Tensor) -> torch.Tensor:
    """
    Convert rotations given as quaternions to axis/angle.
    Adapted from PyTorch3D:
    https://pytorch3d.readthedocs.io/en/latest/_modules/pytorch3d/transforms/rotation_conversions.html#quaternion_to_axis_angle
    Args:
        quaternions: quaternions with real part last,
            as tensor of shape (..., 4).
    Returns:
        Rotations given as a vector in axis angle form, as a tensor
            of shape (..., 3), where the magnitude is the angle
            turned anticlockwise in radians around the vector's
            direction.
    """
    norms = torch.norm(quaternions[..., :3], p=2, dim=-1, keepdim=True)
    half_angles = torch.atan2(norms, quaternions[..., 3:])
    angles = 2 * half_angles
    eps = 1e-6
    small_angles = angles.abs() < eps
    sin_half_angles_over_angles = torch.empty_like(angles)
    sin_half_angles_over_angles[~small_angles] = (
        torch.sin(half_angles[~small_angles]) / angles[~small_angles]
    )
    # for x small, sin(x/2) is about x/2 - (x/2)^3/6
    # so sin(x/2)/x is about 1/2 - (x*x)/48
    sin_half_angles_over_angles[small_angles] = (
        0.5 - (angles[small_angles] * angles[small_angles]) / 48
    )
    return quaternions[..., :3] / sin_half_angles_over_angles
